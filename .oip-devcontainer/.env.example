# Development container secrets.
#
# Copy this file to `.env` next to `dev.yml` and change every value before the installation becomes
# reachable by anyone but you. Docker Compose reads `.env` automatically, so no extra flag is needed:
#
#   cp .env.example .env
#
# The values below are the ones shipped with the repository. They are public - every clone has them.
# Each variable is the single source of truth for its secret: it is substituted both into the
# infrastructure container that owns the secret and into the application configuration that uses it.
#
# Two of them additionally live inside Keycloak and MinIO and cannot be changed by restarting a
# container. After editing them run `./apply-secrets.sh`, which pushes the values into the running
# Keycloak and MinIO. See `doc/en/SecretRotation.md` (`doc/ru/SecretRotation.md`).

# --- Postgres -------------------------------------------------------------------------------------
# Used by the `postgres` container and by Keycloak's `KC_DB_*` settings.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Keycloak admin -------------------------------------------------------------------------------
# Bootstrap administrator of the `master` realm, created only on the first start of a fresh database.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=P@ssw0rd

# --- Keycloak client ------------------------------------------------------------------------------
# Secret of the `oip-backend` confidential client. Must match the client secret stored in Keycloak.
# `keycloak/realm-export.json` is read only on the first start of an empty Keycloak database;
# afterwards the value lives in the Keycloak database - `apply-secrets.sh` writes it there.
KEYCLOAK_CLIENT_SECRET=Xnw6h8wH0dgehxGxZYgWKbKosKCx9E8L

# Shared secret signing the Keycloak event webhook. Must match the `sharedSecret` of the realm's
# `ext-event-http` listener, which `apply-secrets.sh` updates as well.
KEYCLOAK_EVENTS_SHARED_SECRET=change-me-keycloak-events

# --- Redis ----------------------------------------------------------------------------------------
# Used by `redis-server --requirepass` and substituted into the applications' Redis connection string.
REDIS_PASSWORD=P@ssw0rd

# --- MinIO ----------------------------------------------------------------------------------------
# Root account of the MinIO container. It owns the instance and should not be used by applications.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=P@ssw0rd

# Credentials the applications use for object storage. Outside the development container point these
# at a dedicated MinIO service account rather than the root account; `apply-secrets.sh` creates one
# with exactly these values.
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=P@ssw0rd

# --- ClickHouse -----------------------------------------------------------------------------------
# Used by the `clickhouse` container. `Oip.Rtds` still carries the value in `RtsConnectionString`.
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=P@ssw0rd

# --- Grafana --------------------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=admin

# --- Development certificate ----------------------------------------------------------------------
# Password of `https/oip.pfx`, generated by the openssl commands in `.oip-devcontainer/README.md`.
DEV_CERT_PASSWORD=P@ssw0rd
