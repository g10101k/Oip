{
  "ConnectionString": "XpoProvider=Postgres;Server=localhost;Database=oip;uid=postgres;pwd=postgres;",
  "ServiceAddingMode": "Local",
  "Services": {
    "Shell": "https://localhost:5002",
    "ApplicationsService": "https://localhost:5008",
    "UsersService": "https://localhost:5005",
    "DiscussionsService": "https://localhost:5006",
    "NotificationsService": "https://localhost:5007"
  },
  "Application": {
    "Code": "oip",
    "DisplayName": "OIP",
    "BaseUrl": "https://localhost:50002",
    "InternalBaseUrl": "https://localhost:5002",
    "Icon": "pi pi-home",
    "Order": 10,
    "Enabled": true,
    "ServiceType": "Application"
  },
  "SecurityService": {
    "BaseUrl": "https://localhost:8443/",
    "Realm": "oip",
    "ClientId": "oip-backend",
    "Front": {
      "ClientId": "oip-client",
      "Scope": "openid profile email offline_access roles"
    },
    "ClockSkewSeconds": 5,
    "AuthTicketStore": {
      "RedisConnectionString": "localhost:6379,password=P@ssw0rd,defaultDatabase=0",
      "TicketLifetimeMinutes": 20160
    }
  },
  "KeycloakSync": {
    "BatchSize": 100,
    "SyncOnStartup": true
  },
  "UserPhotoStorage": {
    "Endpoint": "localhost:9010",
    "AccessKey": "admin",
    "BucketName": "oip-user-photos",
    "UseSsl": false
  },
  "DiscussionAttachmentStorage": {
    "Endpoint": "localhost:9010",
    "AccessKey": "admin",
    "BucketName": "oip-discussion-attachments",
    "UseSsl": false
  },
  "OpenTelemetry": {
    "Enable": false
  },
  "SmtpSettings": {
    "MailFrom": "noreply@example.com",
    "SmtpHost": "localhost",
    "SmtpPort": 587,
    "EnableSsl": true,
    "SmtpAuthenticationEnabled": true,
    "SmtpUser": "your-username",
    "IsEnable": false
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:5002",
        "Protocols": "Http1AndHttp2"
      }
    }
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Trace"
    }
  },
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "internalLogLevel": "Warn",
    "internalLogFile": "${basedir}/logs/nlog-internal.log",
    "internalLogToConsoleError": true,
    "extensions": [
      {
        "assembly": "NLog.Extensions.Logging"
      },
      {
        "assembly": "NLog.Web.AspNetCore"
      }
    ],
    "variables": {
      "logDirectory": "${basedir}/logs",
      "lineLayout": "${longdate}|${level:uppercase=true:padding=-5}|${threadid}|${logger}|${message}${onexception:inner=${newline}${exception:format=ToString}}"
    },
    "targets": {
      "async": true,
      "file": {
        "type": "File",
        "fileName": "${var:logDirectory}/oip.log",
        "archiveFileName": "${var:logDirectory}/archive/oip.{#}.log",
        "archiveNumbering": "DateAndSequence",
        "archiveDateFormat": "yyyy-MM-dd",
        "archiveEvery": "Day",
        "archiveAboveSize": 10485760,
        "maxArchiveFiles": 30,
        "encoding": "utf-8",
        "layout": "${var:lineLayout}"
      },
      "console": {
        "type": "ColoredConsole",
        "useDefaultRowHighlightingRules": false,
        "layout": "${var:lineLayout}",
        "rowHighlightingRules": [
          {
            "condition": "level == LogLevel.Trace",
            "foregroundColor": "DarkGray"
          },
          {
            "condition": "level == LogLevel.Debug",
            "foregroundColor": "DarkGray"
          },
          {
            "condition": "level == LogLevel.Info",
            "foregroundColor": "Gray"
          },
          {
            "condition": "level == LogLevel.Warn",
            "foregroundColor": "Yellow"
          },
          {
            "condition": "level == LogLevel.Error",
            "foregroundColor": "Red"
          },
          {
            "condition": "level == LogLevel.Fatal",
            "foregroundColor": "Red",
            "backgroundColor": "White"
          }
        ]
      }
    },
    "rules": [
      {
        "logger": "Microsoft.Hosting.Lifetime",
        "minLevel": "Info",
        "writeTo": "file, console",
        "final": true
      },
      {
        "logger": "Microsoft.*",
        "minLevel": "Warn",
        "writeTo": "file, console",
        "final": true
      },
      {
        "logger": "System.Net.Http.*",
        "minLevel": "Warn",
        "writeTo": "file, console",
        "final": true
      },
      {
        "logger": "Oip.*",
        "minLevel": "Info",
        "writeTo": "file, console",
        "final": true
      },
      {
        "logger": "*",
        "minLevel": "Error",
        "writeTo": "file, console"
      }
    ]
  }
}
