<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <SpaRoot>.\..\Oip.WebClient\</SpaRoot>
        <SpaProxyServerUrl>https://localhost:50009</SpaProxyServerUrl>
        <SpaProxyLaunchCommand>npm run start:hil</SpaProxyLaunchCommand>
        <SpaProxyKeepRunning>true</SpaProxyKeepRunning>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.SpaProxy"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Oip.Applications.Base\Oip.Applications.Base.csproj"/>
        <ProjectReference Include="..\Oip.Base\Oip.Base.csproj"/>
        <ProjectReference Include="..\Oip.Discussions.Base\Oip.Discussions.Base.csproj"/>
        <ProjectReference Include="..\Oip.Hil.Base\Oip.Hil.Base.csproj"/>
        <ProjectReference Include="..\Oip.Notifications.Base\Oip.Notifications.Base.csproj"/>
        <ProjectReference Include="..\Oip.Users.Base\Oip.Users.Base.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Content Update="appsettings.Development.json">
            <CopyToPublishDirectory>Never</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

    <Target Name="DebugEnsureNodeEnv" BeforeTargets="Build" Condition=" '$(Configuration)' == 'Debug' And !Exists('$(SpaRoot)node_modules') ">
        <!-- Ensure Node.js is installed -->
        <Exec Command="node --version" ContinueOnError="true">
            <Output TaskParameter="ExitCode" PropertyName="ErrorCode"/>
        </Exec>
        <Error Condition="'$(ErrorCode)' != '0'" Text="Node.js is required to build and run this project. To continue, please install Node.js from https://nodejs.org/, and then restart your command prompt or IDE."/>
        <Message Importance="high" Text="Restoring dependencies using 'npm'. This may take several minutes..."/>
        <Exec WorkingDirectory="$(SpaRoot)" Command="npm install"/>
    </Target>

    <Target Name="PublishRunWebpack" AfterTargets="ComputeFilesToPublish" Condition=" '$(UseAppHost)' != 'false' ">
        <!-- As part of publishing, ensure the JS resources are freshly built in production mode -->
        <Exec WorkingDirectory="$(SpaRoot)" Command="npm install"/>
        <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build:oip-hil"/>

        <!-- Include the newly-built files in the publish output -->
        <ItemGroup>
            <DistFiles Include="$(SpaRoot)dist\oip-hil\**"/>
            <ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
                <RelativePath>wwwroot\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
                <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>
</Project>
